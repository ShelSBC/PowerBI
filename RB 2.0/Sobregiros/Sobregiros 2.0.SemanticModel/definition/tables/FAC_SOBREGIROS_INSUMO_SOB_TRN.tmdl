	column '00 FLG_Tot&Rev_DESC' =
			
			SWITCH(
			    FAC_SOBREGIROS_INSUMO_SOB_TRN[CTA_TOTALERO_FLG],
			    1, "Totalero",
			    0, "Revolvente",
			    "Otros"
			)
		lineageTag: 993e343f-c91c-41a3-b70d-3c0b0ccf5e56
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '00 MACROSEGMENTO_DESC' =
			
			VAR MacrosegmentoTexto = CONVERT(FAC_SOBREGIROS_INSUMO_SOB_TRN[MACROSEGMENTO], STRING)
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(MacrosegmentoTexto) || MacrosegmentoTexto = "", "NC",
			        MacrosegmentoTexto = "99", "NCC",
			        MacrosegmentoTexto
			    )
		lineageTag: 87a08bb9-15c3-4111-83ff-ccf349fa78d1
		summarizeBy: none
		sortByColumn: MACROSEGMENTO

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column '00 FLG_Dig&NDig_DESC' =
			
			SWITCH(
			    INT(FAC_SOBREGIROS_INSUMO_SOB_TRN[FLG_DIG]),
			    1, "Digital",
			    0, "No Digital",
			    "Otros"
			)
		lineageTag: 93834573-1504-4bad-97fd-e99abccea90d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

