	column LIMITES_I_S = ```
			
			VAR ANIOMES = 
			DATE(
			    LEFT(CONVERT(FAC_MIGRACION_SOBREGIROS_INSUMO_SOBREGIROS_DILISA_TRN_NEW[ANIOMES_OBS],STRING),4),
			    RIGHT(CONVERT(FAC_MIGRACION_SOBREGIROS_INSUMO_SOBREGIROS_DILISA_TRN_NEW[ANIOMES_OBS],STRING),2),1)
			
			VAR INICIO = DATE(YEAR(TODAY())-1,MONTH(TODAY())-1,1)
			VAR FIN = DATE(YEAR(TODAY()),MONTH(TODAY())-1,1)
			
			VAR BANDERA = 
			IF(
			    ANIOMES=FIN 
			,"MES_ACT",IF(ANIOMES=INICIO,"MES_ANT","") )
			
			RETURN BANDERA
			```
		lineageTag: 675052aa-079b-4203-8591-0b251012a240
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

