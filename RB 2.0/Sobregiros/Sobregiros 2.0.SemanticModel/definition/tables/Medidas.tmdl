/// Calculos generados para las visualizaciones
table Medidas
	lineageTag: 714d3f32-12b7-441e-9dd4-48d62e1fce9c

	/// Titulo de 30 + 3 meses en libros 
	measure TITULO_30_3_MOB =
			"30 @ 3 MoB " & "("
			    & CALCULATE (
			        MAX ( VDIM_CALENDARIO[MES_ANIO_LETRA] ),
			        FILTER (
			            VDIM_CALENDARIO,
			            VDIM_CALENDARIO[BANDERA_MOB3] = 1
			        )
			    ) & ")"
		lineageTag: e559291c-04fa-4666-ae68-8734b2c2b40b

	/// Titulo de 90 + 9 meses en libros 
	measure TITULO_90_9_MOB =
			"90 @ 9 MoB " & "("
			    & CALCULATE (
			        MAX ( VDIM_CALENDARIO[MES_ANIO_LETRA] ),
			        FILTER (
			            VDIM_CALENDARIO,
			            VDIM_CALENDARIO[BANDERA_MOB9] = 1
			        )
			    ) & ")"
		lineageTag: 74998807-03b9-41e1-8614-12bc8476081b

	/// Color para dato mas actual
	measure color_t0_num_p =
			IF (
			    MAX ( VDIM_CALENDARIO[T0_NUM_P] ) = 1,
			    "black",
			    "rgba(0, 0, 0, 0)"
			)
		lineageTag: b60bf6b6-d69c-4f64-8827-655dbb373718

	/// Calculo de mapa de calor violeta
	measure temadinamico_violeta =
			VAR seleccion_ =
			    SELECTEDVALUE ( VDIM_PRODUCTO[TIP_INF] )
			RETURN
			    IF (
			        seleccion_ = 100,
			        "#666666",
			        IF (
			            seleccion_ = 110,
			            "#ff00ff",
			            "#BF7EB4"
			        )
			    )
		lineageTag: ecd56a50-60f9-4e99-86f7-7b0a1bba3d24

	/// Color de mapa de calor
	measure temadinamico_orange =
			VAR seleccion_ =
			    SELECTEDVALUE ( VDIM_PRODUCTO[TIP_INF] )
			RETURN
			    IF (
			        seleccion_ = 100,
			        "#666666",
			        IF (
			            seleccion_ = 110,
			            "#ff00ff",
			            "#FD6F21"
			        )
			    )
		lineageTag: 3180e3cf-0a39-4dfe-b9a6-484d67b48579

	/// Bandera nombres de titulos
	measure Nombre_Tarjeta =
			VAR NombreDinamico =
			    SELECTEDVALUE (
			        VDIM_PRODUCTO[TIP_INF],
			        ""
			    )
			VAR NombreDinamico_ =
			    SWITCH (
			        TRUE (),
			        NombreDinamico = 110, "Dilisa",
			        NombreDinamico = 100, "LPC"
			    )
			VAR A_ = "Tarjeta " & NombreDinamico_
			RETURN
			    IF (
			        NombreDinamico = "",
			        "Todos los productos",
			        A_
			    )
		lineageTag: ca3102c1-d149-4d5f-9fa7-dcf688d65d60

	/// Color de meses en libros 30+
	measure colorMob3 =
			IF (
			    MAX ( VDIM_CALENDARIO[BANDERA_MOB3] ) = 1,
			    "black",
			    "rgba(0, 0, 0, 0)"
			)
		lineageTag: d948c57b-fb8d-4d55-8670-28012d7cd3c5

