	measure '0 Etiqueta Periodo Actual' =
			
			VAR AnioObjetivo = [00 Año Efectivo]
			VAR MesObjetivo  = [00 Mes Efectivo]
			VAR MesObjetivoTxt = FORMAT ( VALUE ( MesObjetivo ), "00" )
			
			VAR NombreMes =
			    CALCULATE (
			        MAX ( VDIM_CALENDARIO[MES_LETRA] ),
			        REMOVEFILTERS ( VDIM_CALENDARIO ),
			        VDIM_CALENDARIO[MES] = MesObjetivoTxt
			    )
			RETURN
			NombreMes & "'" & RIGHT ( AnioObjetivo, 2 )
		lineageTag: f3eff965-651f-48ae-accb-4a46d4dd2f24

	measure '0 Etiqueta Periodo Anterior' =
			
			VAR AnioActual = [00 Año Efectivo]
			VAR MesActual  = [00 Mes Efectivo]
			VAR AnioObjetivo = VALUE ( AnioActual ) - 1
			VAR MesActualTxt = FORMAT ( VALUE ( MesActual ), "00" )
			
			VAR NombreMes =
			    CALCULATE (
			        MAX ( VDIM_CALENDARIO[MES_LETRA] ),
			        REMOVEFILTERS ( VDIM_CALENDARIO ),
			        VDIM_CALENDARIO[MES] = MesActualTxt
			    )
			RETURN
			NombreMes & "'" & RIGHT ( FORMAT ( AnioObjetivo, "0000" ), 2 )
		lineageTag: d6ddbddf-5602-4cb3-8a45-f2024f93eee9

	measure '01 Saldo $ (Anterior)' = ```
			
			VAR AnioActual = [00 Año Efectivo] 
			VAR MesActual = [00 Mes Efectivo] 
			
			VAR AnioObjetivo = FORMAT ( VALUE ( AnioActual ) - 1, "0000" ) 
			VAR MesObjetivoFormatted = FORMAT ( VALUE ( MesActual ), "00" )
			VAR AnioMesObjetivo = AnioObjetivo & MesObjetivoFormatted 
			
			-- 1. Suma total de importe para el mismo mes del año anterior
			VAR TotalImporteAnterior = 
			    CALCULATE ( 
			        SUM ( FAC_RB_2_SOBREGIROS_TRN[IMP_SOBREGIRO_M] ), 
			        REMOVEFILTERS ( VDIM_CALENDARIO ), 
			        VDIM_CALENDARIO[ANIO_MES] = AnioMesObjetivo 
			    )
			
			-- 2. Suma total de cuentas para el mismo mes del año anterior
			VAR TotalCuentasAnterior = 
			    CALCULATE ( 
			        SUM ( FAC_RB_2_SOBREGIROS_TRN[CTAS_K] ), 
			        REMOVEFILTERS ( VDIM_CALENDARIO ), 
			        VDIM_CALENDARIO[ANIO_MES] = AnioMesObjetivo 
			    )
			
			-- 3. Ratio ponderado del año anterior
			RETURN 
			COALESCE ( 
			    DIVIDE ( TotalImporteAnterior, TotalCuentasAnterior, 0 ) * 1000, 
			    0 
			)
			```
		lineageTag: 448d2a92-eaec-485a-ad6a-51e2dcfdad41

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '01 Saldo $' = ```
			
			VAR AnioObjetivo = [00 Año Efectivo]
			VAR MesObjetivo = [00 Mes Efectivo] 
			VAR MesObjetivoFormatted = FORMAT ( VALUE ( MesObjetivo ), "00" )
			VAR AnioMesObjetivo = AnioObjetivo & MesObjetivoFormatted 
			
			-- 1. Calculamos la suma del importe total para el periodo
			VAR TotalImporte = 
			    CALCULATE ( 
			        SUM ( FAC_RB_2_SOBREGIROS_TRN[IMP_SOBREGIRO_M] ),
			        REMOVEFILTERS ( VDIM_CALENDARIO ), 
			        VDIM_CALENDARIO[ANIO_MES] = AnioMesObjetivo 
			    )
			
			-- 2. Calculamos la suma total de cuentas para el periodo
			VAR TotalCuentas = 
			    CALCULATE ( 
			        SUM ( FAC_RB_2_SOBREGIROS_TRN[CTAS_K] ),
			        REMOVEFILTERS ( VDIM_CALENDARIO ), 
			        VDIM_CALENDARIO[ANIO_MES] = AnioMesObjetivo 
			    )
			
			-- 3. Dividimos los totales agregados
			RETURN 
			COALESCE ( 
			    DIVIDE ( TotalImporte, TotalCuentas, 0 ) * 1000, 
			    0 
			)
			```
		lineageTag: 2c7d0369-63fb-4046-ab99-6c6cfd029b3f

