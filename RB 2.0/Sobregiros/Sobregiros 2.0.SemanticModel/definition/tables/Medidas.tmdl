	measure '1 PROMEDIOS $/#' =
			if (ISBLANK(DIVIDE(SUM(FAC_MIGRACION_SOBREGIROS_INSUMO_SOBREGIROS_DILISA_TRN_NEW[IMP_SOBREGIRO_1000000])
			,SUM(FAC_MIGRACION_SOBREGIROS_INSUMO_SOBREGIROS_DILISA_TRN_NEW[CTAS_MIL])/1000)),0
			,DIVIDE(SUM(FAC_MIGRACION_SOBREGIROS_INSUMO_SOBREGIROS_DILISA_TRN_NEW[IMP_SOBREGIRO_1000000])
			,SUM(FAC_MIGRACION_SOBREGIROS_INSUMO_SOBREGIROS_DILISA_TRN_NEW[CTAS_MIL])/1000))
		formatString: #,0.0
		lineageTag: 4e0627c8-92b7-4f1f-a455-0ad02c0a5237

	measure IMP/CTAS = ```
			
			DIVIDE(
			    SUM(FAC_MIGRACION_SOBREGIROS_INSUMO_SOBREGIROS_DILISA_TRN_NEW[IMP_SOBREGIRO_1000000]),
			    SUM(FAC_MIGRACION_SOBREGIROS_INSUMO_SOBREGIROS_DILISA_TRN_NEW[CTAS])
			) * 1000
			
			```
		lineageTag: fb5e8728-4764-4c69-a624-dbc84467c98e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '00 Año Efectivo' = ```
			
			VAR AnioSeleccionado = SELECTEDVALUE ( VDIM_CALENDARIO[ANIO_YYYY] ) 
			VAR AnioValido = 
			    NOT ISBLANK ( AnioSeleccionado ) && 
			    COUNTROWS ( 
			        FILTER ( 
			            ALL ( FAC_RB_2_SOBREGIROS_TRN ), 
			            FAC_RB_2_SOBREGIROS_TRN[ANIO_ESTR] = AnioSeleccionado 
			        ) 
			    ) > 0 
			RETURN 
			    IF ( 
			        HASONEVALUE ( VDIM_CALENDARIO[ANIO_YYYY] ) && AnioValido, 
			        AnioSeleccionado, 
			        CALCULATE ( 
			            MAX ( FAC_RB_2_SOBREGIROS_TRN[ANIO_ESTR] ), 
			            REMOVEFILTERS ( VDIM_CALENDARIO ) 
			        ) 
			    )
			```
		lineageTag: 5679d1e0-8aa4-41cf-9f3a-8e3f36125cfd

	measure '00 Mes Efectivo' = ```
			
			VAR MesSeleccionado = SELECTEDVALUE ( VDIM_CALENDARIO[MES] ) 
			VAR AnioEfectivo = [00 Año Efectivo] 
			
			VAR MesValido = 
			    NOT ISBLANK ( MesSeleccionado ) && 
			    COUNTROWS ( 
			        FILTER ( 
			            ALL ( FAC_RB_2_SOBREGIROS_TRN ), 
			            FAC_RB_2_SOBREGIROS_TRN[MES_ESTR] = MesSeleccionado 
			            && FAC_RB_2_SOBREGIROS_TRN[ANIO_ESTR] = AnioEfectivo 
			        ) 
			    ) > 0 
			
			RETURN 
			    IF ( 
			        HASONEVALUE ( VDIM_CALENDARIO[MES] ) && MesValido, 
			        MesSeleccionado, 
			        CALCULATE ( 
			            MAX ( FAC_RB_2_SOBREGIROS_TRN[MES_ESTR] ), 
			            REMOVEFILTERS ( VDIM_CALENDARIO ), 
			            FILTER ( 
			                ALL ( FAC_RB_2_SOBREGIROS_TRN ), 
			                FAC_RB_2_SOBREGIROS_TRN[ANIO_ESTR] = AnioEfectivo 
			            ) 
			        ) 
			    )
			```
		lineageTag: a13ecfc9-45d0-4272-9ffe-0832f80e6d79

	measure '01 Cuentas #k' = ```
			
			VAR AnioObjetivo = [00 Año Efectivo]
			VAR MesObjetivo = [00 Mes Efectivo] 
			VAR AnioMesObjetivo = AnioObjetivo & MesObjetivo 
			
			RETURN 
			CALCULATE ( 
			    SUM ( FAC_RB_2_SOBREGIROS_TRN[CTAS_K] ),
			    REMOVEFILTERS ( VDIM_CALENDARIO ), 
			    VDIM_CALENDARIO[ANIO_MES] = AnioMesObjetivo 
			)
			```
		formatString: #,0
		lineageTag: ddd83ff3-6b5f-4664-accb-a0d6c28d377e

	measure '01 Cuentas #k (Anterior)' = ```
			
			VAR AnioActual = [00 Año Efectivo] 
			VAR MesActual = [00 Mes Efectivo] 
			
			-- Convertimos a número solo para restar 1 año y luego volvemos a texto de 4 dígitos
			VAR AnioObjetivo = FORMAT ( VALUE ( AnioActual ) - 1, "0000" ) 
			
			-- Aseguramos que el mes tenga 2 dígitos convirtiendo el texto a número para FORMAT
			VAR MesObjetivoFormatted = FORMAT ( VALUE ( MesActual ), "00" )
			
			VAR AnioMesObjetivo = AnioObjetivo & MesObjetivoFormatted 
			
			RETURN 
			COALESCE ( 
			    CALCULATE ( 
			        SUM ( FAC_RB_2_SOBREGIROS_TRN[CTAS_K] ), 
			        REMOVEFILTERS ( VDIM_CALENDARIO ), 
			        VDIM_CALENDARIO[ANIO_MES] = AnioMesObjetivo 
			    ), 
			    0 
			)
			```
		lineageTag: fa11a924-05f4-4d8d-bf3c-4e08081a67a3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

