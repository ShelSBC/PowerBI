	measure '02 Imp Acum (Anterior)' = ```
			
			VAR AnioActual = [00 Año Efectivo] 
			VAR MesActual = [00 Mes Efectivo] 
			
			-- Calculamos el año anterior convertiéndolo a número y formateándolo a 4 dígitos
			VAR AnioObjetivo = FORMAT ( VALUE ( AnioActual ) - 1, "0000" ) 
			
			-- Aseguramos que el mes tenga 2 dígitos convirtiendo el texto a número para FORMAT
			VAR MesObjetivoFormatted = FORMAT ( VALUE ( MesActual ), "00" )
			VAR AnioMesLimite = AnioObjetivo & MesObjetivoFormatted 
			
			RETURN 
			COALESCE ( 
			    CALCULATE ( 
			        SUM ( FAC_RB_2_SOBREGIROS_TRN[IMP_SOBREGIRO_M] ), 
			        REMOVEFILTERS ( VDIM_CALENDARIO ), 
