	lineageTag: b6514d69-6f0c-4a3a-a12a-4d90a1e1eafb

	measure Saldo_Promedio = ```
			
			CALCULATE ( 
			    DIVIDE ( 
			        SUM ( FAC_RB_2_SOBREGIROS_TRN[IMP_SOBREGIRO_M] ), 
			        SUM ( FAC_RB_2_SOBREGIROS_TRN[CTAS] ), 
			        0 
			    ) * 1000 
			)
			```
