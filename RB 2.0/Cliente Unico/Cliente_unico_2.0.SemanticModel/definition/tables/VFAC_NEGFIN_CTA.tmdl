	measure 30+ = ```
			
			VAR SDO_30 =
			    CALCULATE(
			        SUM(VFAC_NEGFIN_CTA[SDO_ACT_M]),
			        VFAC_NEGFIN_CTA[FLG_30] = "30+"
			    )
			VAR SDO_TOTAL =
			    SUM(VFAC_NEGFIN_CTA[SDO_ACT_M])
			RETURN
			    DIVIDE(SDO_30, SDO_TOTAL, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
