	column '  BANDERA_1ANIO' =
			
			VAR ANIOMES =
			DATE(
			    LEFT(CONVERT(VFAC_TARJETA_GARANTIZADA_MIX_CD_ZNA_TRN[ANIOMES_OBS],STRING),4),
			    RIGHT(CONVERT(VFAC_TARJETA_GARANTIZADA_MIX_CD_ZNA_TRN[ANIOMES_OBS],STRING),2),1)
			
			VAR INICIO= DATE(YEAR(TODAY())-1,MONTH(TODAY())-1,1)
			VAR FIN= DATE(YEAR(TODAY()),MONTH(TODAY())-1,1)
			
			VAR ACUMULADO=IF(ANIOMES>=INICIO && ANIOMES<=FIN,1,0)
			
			RETURN ACUMULADO
		formatString: 0
		lineageTag: 501cdedb-ca72-4acb-8786-d81a8fe2773a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

