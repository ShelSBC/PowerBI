		lineageTag: 11325ad1-2aa2-43b3-8a38-f407e231596a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '03 Cuentas #k Acum.' =
			
			VAR AnioObjetivo = [00 Año Efectivo]
			VAR MesObjetivo = [00 Mes Efectivo]
			VAR AnioMesLimite = AnioObjetivo & FORMAT ( MesObjetivo, "00" )
			RETURN
			CALCULATE (
			SUM ( VFAC_TG_UNIFICADA_V2[CTAS] ),
			REMOVEFILTERS ( VDIM_CALENDARIO ),
			VDIM_CALENDARIO[ANIO_YYYY] = AnioObjetivo,
			VDIM_CALENDARIO[ANIO_MES] <= AnioMesLimite
			)
		lineageTag: 1f6332e1-04d2-40de-9e8b-4c5691c0f8fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '03 Cuentas #k Acum. (Anterior)' =
			
			VAR AnioActual = [00 Año Efectivo]
			VAR MesActual = [00 Mes Efectivo]
			VAR AnioObjetivo = FORMAT ( VALUE ( AnioActual ) - 1, "0000" )
			VAR AnioMesLimite = AnioObjetivo & FORMAT ( MesActual, "00" )
			RETURN
			COALESCE (
			CALCULATE (
			SUM ( VFAC_TG_UNIFICADA_V2[CTAS] ),
			REMOVEFILTERS ( VDIM_CALENDARIO ),
			VDIM_CALENDARIO[ANIO_YYYY] = AnioObjetivo,
			VDIM_CALENDARIO[ANIO_MES] <= AnioMesLimite
			),
			0
			)
		lineageTag: 98001901-b624-4b42-aeb6-70f5fabfd5d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '• Etiqueta Periodo Actual' =
			
			VAR AnioObjetivo = [00 Año Efectivo]
			VAR MesObjetivo = [00 Mes Efectivo]
			VAR MesObjetivoTxt = FORMAT ( MesObjetivo, "00" )
			VAR NombreMes =
			CALCULATE (
			SELECTEDVALUE ( VDIM_CALENDARIO[MES_LETRA] ),
			REMOVEFILTERS ( VDIM_CALENDARIO ),
			FILTER ( ALL ( VDIM_CALENDARIO ), FORMAT ( VDIM_CALENDARIO[MES], "00" ) = MesObjetivoTxt )
			)
			RETURN
			NombreMes & "'" & RIGHT ( AnioObjetivo, 2 )
		lineageTag: b4d1542f-b7a5-4ff8-894d-1c06461d963a

	measure '• Etiqueta Periodo Anterior' =
			
			VAR AnioActual = [00 Año Efectivo]
			VAR MesActual = [00 Mes Efectivo]
			VAR AnioObjetivo = VALUE ( AnioActual ) - 1
			VAR MesActualTxt = FORMAT ( MesActual, "00" )
			VAR NombreMes =
			CALCULATE (
			SELECTEDVALUE ( VDIM_CALENDARIO[MES_LETRA] ),
			REMOVEFILTERS ( VDIM_CALENDARIO ),
			FILTER (
			ALL ( VDIM_CALENDARIO ),
			FORMAT ( VDIM_CALENDARIO[MES], "00" ) = MesActualTxt
			)
			)
			RETURN
			NombreMes & "'" & RIGHT ( FORMAT ( AnioObjetivo, "0000" ), 2 )
		lineageTag: 47dd07c9-f6d7-4058-bb0f-5776b19f103c

	measure '01 Cuentas G #k' =
			
			VAR AnioObjetivo = [00 Año Efectivo]
