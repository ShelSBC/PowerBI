	column LIMITE_ACUM = ```
			
			VAR ANIOMES =
			DATE(
			    LEFT(CONVERT(VFAC_TARJETA_GARANTIZADA_INSCRITOS_TG_TRN[ANIOMES_ESTR],STRING),4),
			    RIGHT(CONVERT(VFAC_TARJETA_GARANTIZADA_INSCRITOS_TG_TRN[ANIOMES_ESTR],STRING),2),1)
			
			VAR INICIO = DATE(YEAR(TODAY())-1,MONTH(TODAY())-1,1)
			VAR FIN = DATE(YEAR(TODAY()),MONTH(TODAY())-1,1)
			
			VAR BANDERA =
			    IF(ANIOMES <= INICIO && YEAR(ANIOMES) = YEAR(INICIO),"ACUM_RI",
			    IF(ANIOMES <= FIN && YEAR(ANIOMES) = YEAR(FIN),"ACUM_RS","")
			
			    ) 
			RETURN BANDERA
			```
		lineageTag: 2a70c5a5-5cff-4089-9191-580dbd49ca2c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

