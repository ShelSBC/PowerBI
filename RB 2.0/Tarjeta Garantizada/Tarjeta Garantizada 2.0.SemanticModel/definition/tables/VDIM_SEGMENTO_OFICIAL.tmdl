/// Contiene el catalogo de Macrosegmento
table VDIM_SEGMENTO_OFICIAL
	lineageTag: befabafb-e204-4332-8116-acddee74af59

	/// Macrosegmento
	column SEGMENTO_OFICIAL
		dataType: string
		lineageTag: 8be1fa02-30b5-46dd-a9ef-74322664d5d6
		summarizeBy: none
		sourceColumn: SEGMENTO_OFICIAL

		annotation SummarizationSetBy = Automatic

	/// Descripcion de macrosegmento premium
	column PTL/PREMIUM = ```
			VAR BANDERA=IF(VDIM_SEGMENTO_OFICIAL[SEG_OFI_DES]>=" 1" && VDIM_SEGMENTO_OFICIAL[SEG_OFI_DES]<=" 5","Premium",IF(VDIM_SEGMENTO_OFICIAL[SEG_OFI_DES]>=" 6" && VDIM_SEGMENTO_OFICIAL[SEG_OFI_DES]<="12","Potenciales") ) RETURN BANDERA 
			```
		lineageTag: 341f0404-5981-4c0a-b910-cf111e961db3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Descripcion de macrosegmento
	column SEG_OFI_DES =
