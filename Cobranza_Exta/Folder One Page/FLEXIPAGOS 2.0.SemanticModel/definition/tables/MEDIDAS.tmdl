/// Castigos % saldo plan año 2
table MEDIDAS
	lineageTag: f43f995d-d4cb-492c-9332-0ef505f53312

	/// Calculo porcentaje 30+
	measure PCT_SDOACT_30 =
			DIVIDE(
			    CALCULATE(SUM(VFAC_NEGFIN_RB_FLEXIPAGOS[SDO_ACT]),VFAC_NEGFIN_RB_FLEXIPAGOS[FLG_30]=1),
			    CALCULATE(SUM(VFAC_NEGFIN_RB_FLEXIPAGOS[SDO_ACT]))
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 4d61ba7e-57c0-403b-990a-51a2da794164

	measure temadinamico_orange = ```
			VAR seleccion_ =
			    SELECTEDVALUE ( VDIM_PRODUCTO[TIP_INF] )
			RETURN
			    IF (
			        seleccion_ = 100,
			        "#666666",
			        IF (
			            seleccion_ = 110,
			            "#ff00ff",
			             IF( seleccion_=210, "#9900FF" , 
			           IF(seleccion_=200 ,"#666666", 
			            "#FD6F21"))
			        )
			    )
			```
		lineageTag: 9dbd0745-51dd-4bde-9aac-825b5e83faa0

	measure temadinamico_violeta = ```
			VAR seleccion_ =
			    SELECTEDVALUE ( VDIM_PRODUCTO[TIP_INF] )
			RETURN
			    IF (
			        seleccion_ = 100,
			        "#666666",
			        IF (
			            seleccion_ = 110,
			            "#ff00ff",
			           IF( seleccion_=210, "#9900FF" , 
			           IF(seleccion_=200 ,"#666666", 
			            "#BF7EB4"))
			        )
			    )
			```
		lineageTag: 207c3c68-20b8-4f06-a230-cd9e098f2217

	measure Nombre_Tarjeta = ```
			VAR NombreDinamico =
			    SELECTEDVALUE (
			        VDIM_PRODUCTO[TIP_INF],
			        ""
			    )
			VAR NombreDinamico_ =
			    SWITCH (
			        TRUE (),
			        NombreDinamico = 110, "Dilisa",
			        NombreDinamico = 100, "LPC",
			         NombreDinamico = 210, "SBB TD",
			        NombreDinamico = 200, "SBB VISA"
			    )
			VAR A_ = "Tarjeta " & NombreDinamico_
			RETURN
			    IF (
			        NombreDinamico = "",
			        "Todos los productos",
			        A_
			    )
			    
			```
		lineageTag: ee853e78-661f-4227-b1b3-04bfdaaea6ae

	measure CTA_SDO_ACT_FLG_30_3 =
			CALCULATE (
			    [CTA_SDO_ACT_FLG_30],
			    FILTER (
			        VFAC_NEGFIN_RB_FLEXIPAGOS,
			        VFAC_NEGFIN_RB_FLEXIPAGOS[ANTIG_ESTR] = 3
			    )
