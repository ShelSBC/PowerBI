			   ),0
			)
			```
		lineageTag: 752290c9-3e35-4f1d-a288-36e90f13851b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ' Y1_CASTIGOS' =
			VAR A =
			    CALCULATE (
			        SUM (VFAC_NEGFIN_RB_FLEXIPAGOS[IMP_CAST] ),
			        VFAC_NEGFIN_RB_FLEXIPAGOS[YTD_CAST] = "Y1",
			        VFAC_NEGFIN_RB_FLEXIPAGOS[RANG_Y1] = 1
			    )
			VAR B =
			    DIVIDE (
			        CALCULATE (
			            SUM ( VFAC_NEGFIN_RB_FLEXIPAGOS[SDO_ACT] ),
			            VFAC_NEGFIN_RB_FLEXIPAGOS[YTD_ESTR] = "Y1",
			            VFAC_NEGFIN_RB_FLEXIPAGOS[RANG_Y1] = 1
			        ),
			        13,
			        0
			    )
			VAR C =
			    DIVIDE (
			        A,
			        B,
			        0
			    )
			RETURN
			    C
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 4a940cc9-83a4-4b30-9b97-681e13c13ef3

	measure ' Y2_CASTIGOS' =
			VAR A =
			    CALCULATE (
			        SUM (VFAC_NEGFIN_RB_FLEXIPAGOS[IMP_CAST] ),
			        VFAC_NEGFIN_RB_FLEXIPAGOS[YTD_CAST] = "Y2",
			        VFAC_NEGFIN_RB_FLEXIPAGOS[RANG_Y2] = 1
			    )
			VAR B =
			    DIVIDE (
			        CALCULATE (
			            SUM ( VFAC_NEGFIN_RB_FLEXIPAGOS[SDO_ACT] ),
			            VFAC_NEGFIN_RB_FLEXIPAGOS[YTD_ESTR] = "Y2",
			            VFAC_NEGFIN_RB_FLEXIPAGOS[RANG_Y2] = 1
			        ),
			        12,
			        0
			    )
			VAR C =
			    DIVIDE (
			        A,
			        B,
			        0
			    )
			RETURN
			    CALCULATE (
			        C,
			        FILTER (
			            VFAC_NEGFIN_RB_FLEXIPAGOS,
			            VFAC_NEGFIN_RB_FLEXIPAGOS[ACTIVA] = 1
			        )
			    )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 6a6f8167-706e-4c1d-a5ad-103099832c4d

