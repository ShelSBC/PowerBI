	measure ' CUENTA_CORRIENTE' = ```
			VAR A = CALCULATE(SUM(VFAC_NEGFIN_RB_FLEXIPAGOS[CTAS]), 
			        FILTER(VFAC_NEGFIN_RB_FLEXIPAGOS,
			                    VFAC_NEGFIN_RB_FLEXIPAGOS[BANDERA_OBS] = "TRUE" &&
			                    VFAC_NEGFIN_RB_FLEXIPAGOS[FLG_ACT] = 1  &&
			                    VFAC_NEGFIN_RB_FLEXIPAGOS[LLAVE_RANG_NIV_MOR] = "0.-CTAS_VIG"
			)
			        )        VAR B =CALCULATE(SUM(VFAC_NEGFIN_RB_FLEXIPAGOS[CTAS]), 
			        FILTER(VFAC_NEGFIN_RB_FLEXIPAGOS,
