	measure CTA_SDO_ACT_FLG_90 = ```
			DIVIDE (
			    CALCULATE (
			        SUM ( VFAC_NEGFIN_RB_FLEXIPAGOS[SDO_ACT] ),
			        VFAC_NEGFIN_RB_FLEXIPAGOS[FLG_90] = 1 
