	column 'Titulos Dinamicos' =
			VAR TextoFijo = "Cobranza: Flexipagos"
			VAR NombreDinamico =
			    SELECTEDVALUE (
			        VFAC_NEGFIN_RB_FLEXIPAGOS[TIP_INF],
			        ""
			    )
			VAR NombreDinamico_ =
			    SWITCH (
			        TRUE (),
			        NombreDinamico = 110, "Dilisa",
			        NombreDinamico = 100, "LPC",
			        NombreDinamico = 210, "TD",
			        NombreDinamico = 200, "VISA"
			    )
			VAR NombreDinamico2 =
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( Titulos[Value3] ) = 0, "Linea de Credito",
			        SELECTEDVALUE ( Titulos[Value3] ) = 1, "Edades",
			        SELECTEDVALUE ( Titulos[Value3] ) = 2, "Segmento Cliente",
			        SELECTEDVALUE ( Titulos[Value3] ) = 3, "Nivel Riesgo",
			        SELECTEDVALUE ( Titulos[Value3] ) = 4, "Segmento RFM",
			        SELECTEDVALUE ( Titulos[Value3] ) = 5, "Antiguedad tarjeta",
			        SELECTEDVALUE ( Titulos[Value3] ) = 6, "Totalero y revolvente"
			    )
			RETURN
			    TextoFijo
		lineageTag: e054ace1-25a4-45c8-9f8f-5a00ca76c7ed
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition MEDIDAS = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_ResultType = Table

