			VAR FIN = DATE(YEAR(TODAY()),MONTH(TODAY())-1,1)
			VAR BANDERA = IF(ANIOMES>=INICIO && ANIOMES <= FIN,"TRUE","FALSE")
			--VAR MAXIMO = MAX(ANIOMES)
			RETURN BANDERA
		lineageTag: 7b67f90e-9eb1-4fcf-8b38-7770dcd80c97
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

