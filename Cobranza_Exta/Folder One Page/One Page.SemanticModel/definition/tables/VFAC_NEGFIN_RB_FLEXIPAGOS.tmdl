	column BANDERA_ESTR =
			
			VAR ANIOMES = DATE(VFAC_NEGFIN_RB_FLEXIPAGOS[ANIO_ESTR],VFAC_NEGFIN_RB_FLEXIPAGOS[MES_ESTR],1)
			VAR INICIO = DATE(YEAR(TODAY())-2,MONTH(TODAY())-1,1)
			VAR FIN = DATE(YEAR(TODAY()),MONTH(TODAY())-1,1)
			VAR BANDERA = IF(ANIOMES>=INICIO && ANIOMES <= FIN,"TRUE","FALSE")
			--VAR MAXIMO = MAX(ANIOMES)
			RETURN BANDERA
		lineageTag: 5379fff5-02c9-45e7-aa6c-6d3157e3a0c1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

