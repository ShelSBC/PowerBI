	column Filtro_Slicer_Dinamico =
			
			VAR MaxFechaHechos = CALCULATE(MAX('FAC_NEGFIN_FORECAST'[FECHA_CARGA]), ALL('FAC_NEGFIN_FORECAST'))
			VAR FechaSlicer = SELECTEDVALUE('vdim_calendario'[FECHA_COMPLETA])
			
			RETURN
			IF(FechaSlicer = MaxFechaHechos, 1, 0)
		formatString: 0
