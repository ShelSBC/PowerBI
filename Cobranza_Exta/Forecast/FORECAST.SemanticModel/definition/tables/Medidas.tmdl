	measure %DIF_DIA_graf = ```
			
			VAR FechaContexto = MAX('FAC_NEGFIN_FORECAST'[FECHA_CARGA])
			VAR Actual = SUM('FAC_NEGFIN_FORECAST'[IMP])
			
			VAR Anterior = 
			    CALCULATE(
			        SUM('FAC_NEGFIN_FORECAST'[IMP]),
			        -- Borramos el filtro de fecha para poder ir atrás, 
			        -- pero MANTENEMOS el filtro del indicador (IND_DES_REAL)
			        ALLEXCEPT('FAC_NEGFIN_FORECAST', 'FAC_NEGFIN_FORECAST'[IND_DES_REAL]),
			        'FAC_NEGFIN_FORECAST'[FECHA_CARGA] = FechaContexto - 1
			    )
			
			RETURN 
			    IF(
			        ISBLANK(Anterior) || Anterior = 0, 
			        0, 
			        DIVIDE(Actual - Anterior, Anterior, 0)
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 14da60a6-c35b-4e46-a57c-d06300a6c88a

