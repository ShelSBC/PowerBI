table Medidas
	lineageTag: c45fb85d-648d-485d-be79-231445b6dc09

	measure CV = ```
			
			VAR ResultadoCV = 
			    CALCULATE(
			        SUM(FAC_NEGFIN_FORECAST[IMP]),
			        FAC_NEGFIN_FORECAST[TIP_PPTO] = "REAL",
			        FAC_NEGFIN_FORECAST[IND_DES] IN {
			            "5.-90",
			            "6.-120",
			            "7.-150",
			            "8.-180",
			            "9.-210_DIAS"
			        }
			    )
			RETURN 
			COALESCE(ResultadoCV, 0)
			```
		lineageTag: eb27b866-71d6-448d-9754-50c7ab9bb1fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ICV = ```
			
			VAR NUMERADOR = [CV]
			VAR DENOMINADOR = 
			    CALCULATE(
			        SUM(FAC_NEGFIN_FORECAST[IMP]),
			        'FAC_NEGFIN_FORECAST'[TIP_PPTO] = "REAL",
			        'FAC_NEGFIN_FORECAST'[IND_DES] IN {
			            "1.-CTAS_VIG",
			            "2.-1-29",
			            "3.-30",
			            "4.-60",
			            "5.-90",
			            "6.-120",
			            "7.-150",
			            "8.-180",
			            "9.-210_DIAS"
			        }
			    )
			VAR Resultado = DIVIDE(NUMERADOR, DENOMINADOR)
			
			RETURN
			    IF(ISBLANK(Resultado), " ", Resultado)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 360d8c93-a3e1-4ce5-836b-4b3a355cf5c1

	measure PERDIDA_NETA = ```
			
			VAR QUITAS =
			    CALCULATE(
			        SUM(FAC_NEGFIN_FORECAST[IMP]),
			        'FAC_NEGFIN_FORECAST'[TIP_PPTO] = "REAL",
			        'FAC_NEGFIN_FORECAST'[IND_DES] = "QUITAS"
			    ) * 1000 
			
			VAR CASTIGOS =
			    CALCULATE(
			        SUM(FAC_NEGFIN_FORECAST[IMP]),
			        'FAC_NEGFIN_FORECAST'[TIP_PPTO] = "REAL",
			        'FAC_NEGFIN_FORECAST'[IND_DES] = "CAST"
			    )
			
			VAR RECU = 
			    CALCULATE(
			        SUM(FAC_NEGFIN_FORECAST[IMP]),
			        'FAC_NEGFIN_FORECAST'[TIP_PPTO] = "REAL",
			        'FAC_NEGFIN_FORECAST'[IND_DES] = "RECUPERACIONES"
			    )
			
			RETURN
			    RECU - QUITAS - CASTIGOS
			```
		lineageTag: 2296794d-75a0-4615-acd2-f9322bf14c2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ANTERIOR_IMP =
			
			VAR FECHASELECCIONADA = MAX('FAC_NEGFIN_FORECAST'[FECHA_CARGA])
			VAR FECHAPREVIA =
			        MAXX(
			            FILTER(
			                ALL('FAC_NEGFIN_FORECAST'[FECHA_CARGA]),
			                'FAC_NEGFIN_FORECAST'[FECHA_CARGA]<FECHASELECCIONADA
			            ),
			            'FAC_NEGFIN_FORECAST'[FECHA_CARGA]
			        )
			RETURN
			CALCULATE(
			    SUM(FAC_NEGFIN_FORECAST[IMP]),
			    'FAC_NEGFIN_FORECAST'[FECHA_CARGA] = FECHAPREVIA
			)
		lineageTag: b49038b2-7eb7-4d9f-8988-c6e51ed2130e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ANTERIOR_CTAS =
			
			VAR FECHASELECCIONADA = MAX('FAC_NEGFIN_FORECAST'[FECHA_CARGA])
			VAR FECHAPREVIA =
			        MAXX(
			            FILTER(
			                ALL('FAC_NEGFIN_FORECAST'[FECHA_CARGA]),
			                'FAC_NEGFIN_FORECAST'[FECHA_CARGA]<FECHASELECCIONADA
			            ),
			            'FAC_NEGFIN_FORECAST'[FECHA_CARGA]
			        )
			RETURN
			CALCULATE(
			    SUM(FAC_NEGFIN_FORECAST[CTAS]),
			    'FAC_NEGFIN_FORECAST'[FECHA_CARGA] = FECHAPREVIA
			)
		lineageTag: dbbb4141-63bc-48b4-85c9-496492f2e61a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %DIF_DIA = ```
			
			VAR FechaFila = MAX('FAC_NEGFIN_FORECAST'[FECHA_CARGA])
			VAR Actual = SUM('FAC_NEGFIN_FORECAST'[IMP])
			
			VAR Anterior = 
			    CALCULATE(
			        SUM('FAC_NEGFIN_FORECAST'[IMP]),
			        ALL('FAC_NEGFIN_FORECAST'[FECHA_CARGA]), -- Quitamos el filtro solo de la fecha
			        'FAC_NEGFIN_FORECAST'[FECHA_CARGA] = FechaFila - 1
			    )
			
			RETURN 
			    DIVIDE(Actual - Anterior, Anterior, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1efca07f-6957-4e9d-a3c9-0b8bc56d927d

	measure SEMAFORO_DIF_DIA =
			
			SWITCH(
			    TRUE(),
			    [%DIF_DIA] > 0, "POSITIVO",
			    [%DIF_DIA] < 0, "NEGATIVO"
			)
		lineageTag: 4ca30acc-af42-4819-abaf-d58ea2c7714b

	measure %DIF_PPTO =
			
			
			VAR ACTUAL =
			
			    CALCULATE(
			
			        SUM(FAC_NEGFIN_FORECAST[IMP]),
			
			        FAC_NEGFIN_FORECAST[TIP_PPTO] = "REAL"
			
			    )
			
			
			
			VAR PPTO_ORIGINAL =
			
			    CALCULATE(
			
			        SUM(FAC_NEGFIN_FORECAST[IMP]),
			
			        FAC_NEGFIN_FORECAST[TIP_PPTO] <> "REAL",
			
			        ALL(FAC_NEGFIN_FORECAST[TIP_PPTO])
			
			    )
			
			
			
			-- Normalizamos el PPTO multiplicando por 100 para igualar la escala del REAL
			
			VAR PPTO_AJUSTADO = PPTO_ORIGINAL * 1000
			
			
			
			RETURN
			
			   IF(
			
			        ISBLANK(ACTUAL) || ISBLANK(PPTO_ORIGINAL),
			
			        0,
			
			        DIVIDE(ACTUAL - PPTO_AJUSTADO, PPTO_AJUSTADO, 0)
			
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6e25e4bd-7fa4-4c50-9d8c-f563b15203fb

	measure MONTO_PPTO_QUITAS = ```
			
			VAR PPTO_ORIGINAL = 
			    CALCULATE(
			        SUM(FAC_NEGFIN_FORECAST[IMP]), 
			        FAC_NEGFIN_FORECAST[TIP_PPTO] <> "REAL",
			        FAC_NEGFIN_FORECAST[TIP_IND] = 9,
			        ALL(FAC_NEGFIN_FORECAST[TIP_PPTO])
			    )
			RETURN PPTO_ORIGINAL * 1000
			```
		lineageTag: f1371350-8355-4775-ae19-175f43772174

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %DIF_PPTO_QUITAS = ```
			
			VAR ACTUAL_M = [REAL_QUITAS_REINFLADO]
			
			VAR PPTO_M = 
			    CALCULATE(
			        SUM(FAC_NEGFIN_FORECAST[IMP]) * 1000, 
			        FAC_NEGFIN_FORECAST[TIP_PPTO] <> "REAL",
			        FAC_NEGFIN_FORECAST[TIP_IND] = 9,
			        ALL(FAC_NEGFIN_FORECAST[TIP_PPTO])
			    )
			
			RETURN 
			    DIVIDE(ACTUAL_M - PPTO_M, PPTO_M, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 59542540-33ed-44af-b344-cd198a46d984

	measure %DIF_PPTO_RECU_FINAL = ```
			
			VAR ACTUAL = [RECUPERACION_REAL] -- Asegúrate que esta medida ya tenga REMOVEFILTERS
			VAR PPTO = [PPTO_VALOR_TARGET]
			RETURN 
			    DIVIDE(ACTUAL - PPTO, PPTO, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bef09416-cfce-4a46-b59b-f8f64ee3044c

	measure %DIF_PPTO_CAST = ```
			
			VAR ACTUAL = 
			    CALCULATE(
			        SUM(FAC_NEGFIN_FORECAST[IMP]), 
			        FAC_NEGFIN_FORECAST[TIP_PPTO] = "REAL",
			        FAC_NEGFIN_FORECAST[IND_DES] = "CAST"
			    )
			
			VAR PPTO_AJUSTADO = 
			    CALCULATE(
			        SUM(FAC_NEGFIN_FORECAST[IMP])*1000, 
			        FAC_NEGFIN_FORECAST[TIP_PPTO] <> "REAL",
			         FAC_NEGFIN_FORECAST[IND_DES] = "CAST"
			    )
			
			-- Normalizamos el PPTO multiplicando por 100 para igualar la escala del REAL
			
			
			RETURN 
			   IF(
			        ISBLANK(ACTUAL) || ISBLANK(PPTO_AJUSTADO), 
			        0, 
			        DIVIDE(ACTUAL-PPTO_AJUSTADO, PPTO_AJUSTADO, 0)
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fce29149-9255-47e7-b43d-86a962b8d445

