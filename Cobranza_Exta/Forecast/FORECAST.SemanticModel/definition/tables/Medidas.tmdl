	measure Filtro_Ultima_Fecha =
			
			VAR MaxFecha = CALCULATE(MAX('FAC_NEGFIN_FORECAST'[FECHA_CARGA]), ALL('FAC_NEGFIN_FORECAST'))
			RETURN
			IF(SELECTEDVALUE('FAC_NEGFIN_FORECAST'[FECHA_CARGA]) = MaxFecha, 1, 0)
		formatString: 0
		lineageTag: f5f7ebcd-9015-4b31-89b0-b5e21da474f2

	measure RECUPERACION_REAL =
			
			CALCULATE(
			    SUMX(
			        FAC_NEGFIN_FORECAST,
			        VAR EsUltimoDia = (FAC_NEGFIN_FORECAST[FECHA_CARGA] = EOMONTH(FAC_NEGFIN_FORECAST[FECHA_CARGA], 0))
			        RETURN
			        IF(
			            FAC_NEGFIN_FORECAST[TIP_INF] = 110 &&
			            FAC_NEGFIN_FORECAST[TIP_PPTO] = "REAL" &&
			            FAC_NEGFIN_FORECAST[IND_DES] = "RECUPERACIONES",
			            [IMP] * 1.16,
			            [IMP]
			        )
			    ),
			    ALL(FAC_NEGFIN_FORECAST[TIP_PPTO]) -- <--- Esto obliga a la medida a ignorar el Slicer
			
			)
		lineageTag: 850d48f0-1646-4535-9a00-3e3941ed0bc7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FECHA_ACTUALIZACION =
			
