	measure Var_porc_cta_ab =
			FORMAT(
			    DIVIDE(sum(VFAC_COB_PROD_ABOGADOS[CTAS_ABANDN]) - [cta_ABA_MA], [cta_ABA_MA], 0),
			    "0.0%"
