	measure POR_EDO_CTA =
			
			DIVIDE(
			    [Tot_ctas_asig],
			    CALCULATE([Tot_ctas_asig], ALL(VFAC_COB_ASIG_ABO_EDO[ESTADO],VFAC_COB_ASIG_ABO_EDO[AGENCIA]))
