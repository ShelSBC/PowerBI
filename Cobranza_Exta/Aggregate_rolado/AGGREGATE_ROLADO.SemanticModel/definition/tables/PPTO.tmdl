		lineageTag: d2789b1e-0624-49d6-8176-79c4962db92b
		summarizeBy: none
		sourceColumn: ANIOMES

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Descripción de organización 
	column PRODUCTO = ```
			IF(PPTO[TIP_INF] = 100 ,"LPC", 
			         IF(PPTO[TIP_INF] = 110 ,"DILISA", 
			        IF(PPTO[TIP_INF] = 200 ,"SUBURBIA VISA",
			        IF(PPTO[TIP_INF] = 210 ,"SUBURBIA DEPARTAMENTAL",
			         IF(PPTO[TIP_INF] IN {220,230},"MINI PAGOS (CC)","")))))
			```
		lineageTag: 3323fecf-4bf7-4ff7-8ab2-060c6b6c625e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

