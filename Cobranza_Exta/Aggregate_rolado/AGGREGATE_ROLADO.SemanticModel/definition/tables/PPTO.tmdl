/// Presupuestos
table PPTO
	lineageTag: abf08190-0449-4bb2-a13c-cdb74fe14092

	/// Diferencia de Presupuesto Actual vs (REV, ME)
	measure 'DIFERENCIA PPTO' = COALESCE(PPTO[IMP_REAL],0)-COALESCE(PPTO[IMP_PLAN],0)
		lineageTag: 738a171f-eada-46c0-9ddc-873700b483db

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Semaforeo  de presupuestos
	measure SEMAFORO =
			
			SWITCH(
			    TRUE(),
			    [DIFERENCIA PPTO] > 0, "POSITIVO",
			    [DIFERENCIA PPTO] < 0, "NEGATIVO"
			)
		lineageTag: a02439d1-57c7-4106-9e97-5ff779082fd7

	measure IMP_TOTAL =
			CALCULATE(
			    SUM(PPTO[IMP]),
			    FILTER(
			        PPTO,
			        PPTO[TIP_IND] >= 0 && PPTO[TIP_IND] <= 8
			    )
			)
		lineageTag: 55286628-0948-4e63-bd15-29c80174f93d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IMP_PLAN = CALCULATE([IMP_TOTAL]*1000,FILTER(PPTO,PPTO[TIP_PPTO] IN {"PPTO ME","PPTO REV"}))
		lineageTag: 97148c98-83d0-4df5-a00c-6bb0f6d29a4c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IMP_REAL = CALCULATE([IMP_TOTAL],PPTO[TIP_PPTO]="REAL")
		lineageTag: e4ee0c01-95b2-4701-84c9-be15c7ff60d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IMP_TOTAL_% =
			
			CALCULATE(
			    AVERAGE(PPTO[IMP]),
			    FILTER(
			        ALL(PPTO),
			        PPTO[TIP_IND] >= 21 && PPTO[TIP_IND] <= 28
			    )
			)
		lineageTag: bb6c2be7-a020-4e8d-830b-623511be5258

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IMP_PLAN_% = CALCULATE([IMP_TOTAL_%],FILTER(PPTO,PPTO[TIP_PPTO] IN {"PPTO ME","PPTO REV"}))
		lineageTag: 9dd248c9-38a4-4808-a88a-279634440730

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Suma_Porcentajes_Seleccionados =
			
			SUMX(
			    FILTER('PPTO', 'PPTO'[TIP_IND] >= 21 && 'PPTO'[TIP_IND] <= 28),
			    'PPTO'[IMP]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 39719f7e-5ba5-430a-a6fe-b3f47ee0c516

	measure ROLADO_SDO_TOTAL_REAL =
			
			CALCULATE(
			    AVERAGE(ppto[ROLADO_SDO]),
			    ALL(ppto[TIP_PPTO])
			)
		lineageTag: 3e701188-fda0-4549-a748-9c00f19891dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DIFERENCIA PPTO %' = COALESCE(PPTO[IM_REAL%],0)-COALESCE(PPTO[Suma_Porcentajes_Seleccionados],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ca40cf50-e4cd-422a-8b48-1feaef8b9e3d

	measure SEMAFORO_PPTO_% =
			
			SWITCH(
			    TRUE(),
			    [DIFERENCIA PPTO %] > 0, "POSITIVO",
			    [DIFERENCIA PPTO %] < 0, "NEGATIVO",
			    "NEUTRAL"
			)
		lineageTag: 7a471fb9-cf15-4f28-b6b4-14a83d8c3ff3

	measure Aggregate_150_210_ppto =
			
			VAR _filtro_seleccionado = SELECTEDVALUE('PPTO'[IND_DES_REAL])
			
			VAR Suma_26 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 26)
			VAR Suma_27 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 27)
			VAR Suma_28 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 28)
			
			RETURN
			    IF(
			        NOT ISBLANK(_filtro_seleccionado),
			        Suma_26 * Suma_27 * Suma_28
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e7383524-a20d-4e89-83ae-acfbf304d0a1

	measure AGGREGATE_X_120_ppto =
			
			VAR _filtro_seleccionado = SELECTEDVALUE('PPTO'[IND_DES_REAL])
			
			VAR Suma_21 = CALCULATE(AVERAGE(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 21)
			VAR Suma_22 = CALCULATE(AVERAGE(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 22)
			VAR Suma_23 = CALCULATE(AVERAGE(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 23)
			VAR Suma_24 = CALCULATE(AVERAGE(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 24)
			VAR Suma_25 = CALCULATE(AVERAGE(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 25)
			
			RETURN
			    IF(
			        NOT ISBLANK(_filtro_seleccionado),
			        Suma_21 * Suma_22 * Suma_23 * Suma_24 * Suma_25,
			        BLANK()
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b4b2fc8c-eb54-4bbb-8d8e-e1be62a59248

	measure IND_DES_REAL_SELECCIONADO = ```
			
			                            SELECTEDVALUE('PPTO'[IND_DES_REAL],"All")
			```
		lineageTag: 1feade24-0fe3-4728-b846-13705521e6ec

	measure AGGREGATE_REAL_X_120 =
			
			VAR Rolado2 = CALCULATE('PPTO'[IM_REAL%], PPTO[IND_DES_REAL] = "2.-1-29")
			VAR Rolado3 = CALCULATE('PPTO'[IM_REAL%], PPTO[IND_DES_REAL] = "3.-30")
			VAR Rolado4 = CALCULATE('PPTO'[IM_REAL%], PPTO[IND_DES_REAL] = "4.-60")
			VAR Rolado5 = CALCULATE('PPTO'[IM_REAL%], PPTO[IND_DES_REAL] = "5.-90")
			VAR Rolado6 = CALCULATE('PPTO'[IM_REAL%], PPTO[IND_DES_REAL] = "6.-120")
			
			RETURN
			    COALESCE(Rolado2, 0) *
			    COALESCE(Rolado3, 0) *
			    COALESCE(Rolado4, 0) *
			    COALESCE(Rolado5, 0) *
			    COALESCE(Rolado6, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f4163c11-042b-4a08-ad58-ecfb9aa22728

	measure Agregate_150_210_REAL_Final =
			
			VAR Rolado6 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "7.-150"
			)
			VAR Rolado7 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "8.-180"
			)
			VAR Rolado8 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "9.-210"
			)
			RETURN
			    Rolado6 * Rolado7 * Rolado8
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 614c3e4d-3e0e-4522-bc72-57c16210e884

	measure IM_REAL% =
			
			CALCULATE(
			    DIVIDE(SUM(PPTO[IMP]), SUM(PPTO[IMP_ANT])),
			    PPTO[tip_ppto] = "real"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: abf77e0b-13a5-44de-ab1e-86328db564bb

	/// Organización
