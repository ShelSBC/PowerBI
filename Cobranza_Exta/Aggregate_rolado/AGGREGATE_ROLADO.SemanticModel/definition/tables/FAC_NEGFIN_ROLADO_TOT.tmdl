table FAC_NEGFIN_ROLADO_TOT
	lineageTag: e0d02440-1663-4d0f-9b70-b4f4635be952

	measure 'Medida Multiplicacion' =
			
			VAR Rolado6 = CALCULATE(
			    'FAC_NEGFIN_ROLADO_TOT'[ROLADO_REAL],
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "7.-150")
			)
			VAR Rolado7 = CALCULATE(
			    'FAC_NEGFIN_ROLADO_TOT'[ROLADO_REAL],
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "8.-180")
			)
			VAR Rolado8 = CALCULATE(
			    'FAC_NEGFIN_ROLADO_TOT'[ROLADO_REAL],
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "9.-210")
			)
			RETURN
			    Rolado6 * Rolado7 * Rolado8
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4c281989-fe76-43c0-b2b2-410610e8ca4f

	measure ROLADO_REAL = DIVIDE(SUM('FAC_NEGFIN_ROLADO_TOT'[SUM_SDO_ACT]),SUM('FAC_NEGFIN_ROLADO_TOT'[SDO_ANT]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 281661f2-7f66-4f44-bc31-e858640acc14

