table FAC_NEGFIN_COB_PLANES
	lineageTag: 17944660-0a52-4192-a43f-bdd6d48c2963

	measure '% Participación Saldo por Mora CORREGIDO' = ```
			
			VAR SaldoPlanActual =
			    [Saldo Total Activo] // Saldo filtrado por Categoria y/o Indicador_Cobranza
			    
			VAR SaldoTotalDeMora =
			    CALCULATE(
			        [Saldo Total Activo],
			        ALL('FAC_NEGFIN_COB_PLANES'[CATEGORIA], 'FAC_NEGFIN_COB_PLANES'[indicador_cobranza])
			    )
			
			RETURN
			    DIVIDE(
			        SaldoPlanActual,
			        SaldoTotalDeMora,
			        0
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 062305a5-0613-4895-a27a-31cf42874262

	measure 'Saldo Total Activo' =
			
			-- Mide la suma del saldo de cuenta (SDO_CTA) en el contexto de filtro actual.
			SUM('FAC_NEGFIN_COB_PLANES'[SDO_CTA])
		lineageTag: 51de3716-9d09-44ec-a5b2-770b2f4faa93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

