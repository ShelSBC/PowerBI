			    SELECTEDVALUE(FAC_NEGFIN_ROLADO_TOT[CD_INI]) = 8, [ROLADO 180 BEGINDT],
			    SELECTEDVALUE(FAC_NEGFIN_ROLADO_TOT[CD_INI]) = 9, [ROLADO 210 BEGINDT],
