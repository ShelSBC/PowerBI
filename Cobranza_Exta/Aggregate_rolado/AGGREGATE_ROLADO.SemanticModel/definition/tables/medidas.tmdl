	measure 'ROLADO 150 BEGINDT' = ```
			
			VAR _SaldoRodadoMesSiguiente =
			    CALCULATE(
			        SUM('FAC_NEGFIN_COB_ROLADOS'[SALDO]),
			        'FAC_NEGFIN_COB_ROLADOS'[TIPO] = "Total",
			        'FAC_NEGFIN_COB_ROLADOS'[CD_INI] = 7,
			        DATEADD('VDIM_CALENDARIO'[FECHA_COMPLETA], 1, MONTH) 
			    )
			VAR _SaldoBaseMesActual =
			    CALCULATE(
			        SUM('FAC_NEGFIN_COB_ROLADOS'[SALDO]),
			        'FAC_NEGFIN_COB_ROLADOS'[TIPO] = "Total",
			        'FAC_NEGFIN_COB_ROLADOS'[CD_INI] = 6
			    )
			RETURN
			    DIVIDE(_SaldoRodadoMesSiguiente, _SaldoBaseMesActual, BLANK())
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6e5554b6-cac2-4fad-b9ac-26c07a3760ea

