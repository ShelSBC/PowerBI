table medidas
	lineageTag: 812fc5ea-b19f-451a-b792-a3d9a8489ec2

	measure AGGREGATE_ORG_FINAL_120 = ```
			
			VAR OrganizacionSeleccionada = SELECTEDVALUE(VDIM_TIPO_TARJETA[ORG])
			VAR MedidaBase = [Aggregate_x_120_segun_portafolio] // Tu medida de agregado existente
			
			RETURN
			    SWITCH(
			        TRUE(),
			        
			        // 1. Mostrar el Total General: Cuando no hay ORG seleccionada.
			        NOT(HASONEVALUE(VDIM_TIPO_TARJETA[ORG])), 
			            MedidaBase, 
			            
			        // 2. Caso LIVERPOOL (SIN CAMBIOS - LPC queda aquí):
			        OrganizacionSeleccionada = "LIVERPOOL",
			            CALCULATE(
			                MedidaBase,
			                KEEPFILTERS(VDIM_TIPO_TARJETA[PRODUCTO] IN {"LPC", "DILISA"})
			            ),
			        
			        // 3. Caso SUBURBIA (INCLUYE CC y MP, PERO NO LPC):
			        OrganizacionSeleccionada = "SUBURBIA",
			            CALCULATE(
			                MedidaBase,
			                // Filtra por productos Suburbia (SBB VISA, SBB TD) Y los productos a agrupar (CC y MP)
			                KEEPFILTERS(VDIM_TIPO_TARJETA[PRODUCTO] IN {"SBB VISA", "SBB TD", "CC", "Minipagos"}) // <--- Cambia "MP" por el nombre real.
			            ),
			        
			        // Caso por defecto
			        BLANK()
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8cb90124-b7f7-4c6d-a7de-9e373fa4aa26

	measure AGGREGATE_ORG_FINAL_210 = ```
			
