	measure Agregate_X_210_REAL_Final =
			
			VAR Rolado2 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "2.-1-29"
			)
			VAR Rolado3 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "3.-30"
			)
			VAR Rolado4 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "4.-60"
			)
			VAR Rolado5 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "5.-90"
			)
			VAR Rolado6 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "6.-120"
			)
			VAR Rolado7 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "7.-150"
			)
			VAR Rolado8 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "8.-180"
			)
			VAR Rolado9 = CALCULATE(
			    'PPTO'[IM_REAL%],
			    'PPTO'[IND_DES_REAL] = "9.-210"
			)
			RETURN
			    ROLADO2*ROLADO3*ROLADO4*ROLADO5*Rolado6 * Rolado7 * Rolado8*ROLADO9
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 21253b0b-68d7-49e7-ac4e-6d3d2045152a

	measure Aggregate_x_210_ppto =
			
			VAR _filtro_seleccionado = SELECTEDVALUE('PPTO'[IND_DES_REAL])
			
			VAR Suma_21 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 21)
			VAR Suma_22 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 22)
			VAR Suma_23 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 23)
			VAR Suma_24 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 24)
			VAR Suma_25 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 25)
			VAR Suma_26 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 26)
			VAR Suma_27 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 27)
			VAR Suma_28 = CALCULATE(SUM(ppto[IMP]), REMOVEFILTERS('PPTO'[IND_DES_REAL]), ppto[TIP_IND] = 28)
			
			RETURN
			    IF(
			        NOT ISBLANK(_filtro_seleccionado),
			        Suma_21 * Suma_22 * Suma_23*Suma_24 * Suma_25 * Suma_26 * Suma_27 * Suma_28)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c5aec3b2-417f-4c60-b741-1d1050214a6a

