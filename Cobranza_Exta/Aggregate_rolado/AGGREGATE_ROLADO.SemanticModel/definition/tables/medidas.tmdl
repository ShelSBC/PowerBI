		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4d6bff9e-6c2f-4d09-9a3a-a47b2d01eba4

	measure 'Aggregate x-210' =
			
			VAR Rolado1 = CALCULATE(
			    MAX('FAC_NEGFIN_ROLADO_TOT'[ROLADO_SDO]),
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "2.-1-29")
			)
			VAR Rolado2 = CALCULATE(
			    MAX('FAC_NEGFIN_ROLADO_TOT'[ROLADO_SDO]),
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "3.-30")
			)
			VAR Rolado3 = CALCULATE(
			    MAX('FAC_NEGFIN_ROLADO_TOT'[ROLADO_SDO]),
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "4.-60")
			)
			VAR Rolado4 = CALCULATE(
			    MAX('FAC_NEGFIN_ROLADO_TOT'[ROLADO_SDO]),
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "5.-90")
			)
			VAR Rolado5 = CALCULATE(
			    MAX('FAC_NEGFIN_ROLADO_TOT'[ROLADO_SDO]),
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "6.-120")
			)
			VAR Rolado6 = CALCULATE(
			    MAX('FAC_NEGFIN_ROLADO_TOT'[ROLADO_SDO]),
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "7.-150")
			)
			VAR Rolado7 = CALCULATE(
			    MAX('FAC_NEGFIN_ROLADO_TOT'[ROLADO_SDO]),
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "8.-180")
			)
			VAR Rolado8 = CALCULATE(
			    MAX('FAC_NEGFIN_ROLADO_TOT'[ROLADO_SDO]),
			    FILTER('FAC_NEGFIN_ROLADO_TOT', 'FAC_NEGFIN_ROLADO_TOT'[NIV_MOR_FORECAST] = "9.-210")
			)
			RETURN
			    Rolado1 *Rolado2 *Rolado3 *Rolado4 *Rolado5 *Rolado6 * Rolado7 * Rolado8
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 475f39f2-b4f3-4ade-98a4-5dea3324b07d

	measure AGGREGATE_ORG_FINAL_x_210 = ```
			
