	measure rolado%x_210_segun_portafolio = ```
			
			VAR EsPortafolioSeleccionado = ISFILTERED('FAC_NEGFIN_COB_ROLADOS'[PORTAFOLIO])
			    
			RETURN
			    IF(
			        EsPortafolioSeleccionado,
			        [todos_rolados],          
			        MAX('FAC_NEGFIN_ROLADO_TOT'[ROLADO_SDO])     
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 64cc0310-8d58-44a1-a674-9b6ac707d523

	measure rolado$x_210_segun_portafolio_FINAL_V15 = ```
			
			VAR EsPortafolioSeleccionado = ISFILTERED('FAC_NEGFIN_COB_ROLADOS'[PORTAFOLIO])
			VAR MoraEje = SELECTEDVALUE(FAC_NEGFIN_ROLADO_TOT[CD_INI]) 
			
			RETURN
			    IF(
			        NOT EsPortafolioSeleccionado,
			        SUM('FAC_NEGFIN_ROLADO_TOT'[SUM_SDO_ACT]), 
			        
			        -- IF principal: Mora 1 a 5 (Mora Baja: TIPO=Rolada, FLAG=0)
			        IF(
			            MoraEje <= 5, 
			            
			            -- Rama A: MORA BAJA (1 a 5)
			            CALCULATE(
			                SUM('FAC_NEGFIN_COB_ROLADOS'[SALDO]),
			                TREATAS(
			                    VALUES(FAC_NEGFIN_ROLADO_TOT[CD_INI]), 
			                    'FAC_NEGFIN_COB_ROLADOS'[CD_INI]
			                ), 
			                'FAC_NEGFIN_COB_ROLADOS'[TIPO] = "Rolada",
			                'FAC_NEGFIN_COB_ROLADOS'[FLAG] = 0
			            ),
			            
			            -- ELSE IF anidado: Mora 6 O Mora 7, 8, 9 (TIPO=Total, Sin FLAG)
			            CALCULATE(
			                SUM('FAC_NEGFIN_COB_ROLADOS'[SALDO]),
			                TREATAS(
			                    VALUES(FAC_NEGFIN_ROLADO_TOT[CD_INI]), 
			                    'FAC_NEGFIN_COB_ROLADOS'[CD_INI]
			                ), 
			                'FAC_NEGFIN_COB_ROLADOS'[TIPO] = "Total", -- ¡CAMBIO CLAVE: Usar TIPO="Total" para Mora 6!
			                REMOVEFILTERS('FAC_NEGFIN_COB_ROLADOS'[FLAG]) 
			            )
			        )
			    )
			```
		lineageTag: 036280b9-b243-401f-8170-632f3ca4915e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Color_Condicional_Portafolio = ```
			
			VAR PortafolioSeleccionado =
			    -- Devuelve el nombre del portafolio, SOLO si se selecciona UNO.
			    IF(
			        HASONEFILTER('FAC_NEGFIN_COB_ROLADOS'[Portafolio]),
			        VALUES('FAC_NEGFIN_COB_ROLADOS'[Portafolio]),
			        BLANK()
			    )
			    
			RETURN
			    SWITCH(
			        TRUE(),
			        
			        -- Condición 1: Se ha seleccionado el portafolio 'Extrajudicial'
			        PortafolioSeleccionado = "Extrajudicial",
			        "#78256F", -- ¡TU COLOR! Morado Oscuro
			
			        -- Condición 2: Se ha seleccionado el portafolio 'Administrativa'
			        PortafolioSeleccionado = "Administrativa",
			        "#b71066", -- ¡TU COLOR! Fucsia/Magenta
			
			        -- Condición 3: No se ha seleccionado ningún portafolio (se ve el Total Global)
			        ISFILTERED('FAC_NEGFIN_COB_ROLADOS'[Portafolio]) = FALSE(),
			        "#C499CA", -- ¡TU COLOR! Lila/Malva
			
			        -- Condición 4 (DEFAULT): Se seleccionaron Múltiples portafolios 
			        -- (o cualquier otra combinación que no caiga en las anteriores)
			        "#f39c12" -- Naranja (Color de seguridad/multiselección)
			    )
			```
		lineageTag: 0e9d032d-3555-492e-a4a5-dff784632eba

	measure UltimaFecha = MAX('VDIM_CALENDARIO'[MES])
		lineageTag: 868ff4a0-5f1c-4d97-9bf7-3f205f360450

	measure EsMesMasReciente =
			
			VAR MaxDate = [UltimaFecha]
			VAR MaxMonthYear = EOMONTH( MaxDate, 0 ) -- Fin de mes de la fecha más reciente
			VAR CurrentMonthYear = EOMONTH( MAX('VDIM_CALENDARIO'[FECHA_COMPLETA]), 0 ) -- Fin de mes de la fila actual
			RETURN
			    IF ( CurrentMonthYear = MaxMonthYear, 1, 0 )
		formatString: 0
		lineageTag: 34104c42-fe68-4fce-bf7a-12d7c2a551b9

	measure rolado$x_210_segun_portafolio_V19 = ```
			
			VAR EsPortafolioSeleccionado = ISFILTERED('FAC_NEGFIN_COB_ROLADOS'[PORTAFOLIO])
			
			-- 1. Obtenemos los valores de la tabla TOT y los convertimos a número para asegurar el match
			VAR ValoresMoraTOT = 
			    SELECTCOLUMNS(
			        DISTINCT(FAC_NEGFIN_ROLADO_TOT[CD_INI]),
			        "Mora", VALUE([CD_INI])
			    )
			
			-- 2. Obtenemos la mora máxima seleccionada en el contexto actual
			VAR MoraEje = VALUE(MAX(FAC_NEGFIN_ROLADO_TOT[CD_INI]))
			
			RETURN
			    IF(
			        NOT EsPortafolioSeleccionado,
			        SUM('FAC_NEGFIN_ROLADO_TOT'[SUM_SDO_ACT]), 
			        
			        IF(
			            MoraEje <= 5,
			            
			            -- Rama A: Mora Baja
			            CALCULATE(
			                SUM('FAC_NEGFIN_COB_ROLADOS'[SALDO]),
			                -- TREATAS mapea nuestra lista virtual de números a la columna física
			                TREATAS(ValoresMoraTOT, 'FAC_NEGFIN_COB_ROLADOS'[CD_INI]),
			                'FAC_NEGFIN_COB_ROLADOS'[TIPO] = "ROLADA",
			                'FAC_NEGFIN_COB_ROLADOS'[FLAG] = 0
			            ),
			            
			            -- Rama B: Mora Alta
			            CALCULATE(
			                SUM('FAC_NEGFIN_COB_ROLADOS'[SALDO]),
			                TREATAS(ValoresMoraTOT, 'FAC_NEGFIN_COB_ROLADOS'[CD_INI]),
			                'FAC_NEGFIN_COB_ROLADOS'[TIPO] = "TOTAL",
			                REMOVEFILTERS('FAC_NEGFIN_COB_ROLADOS'[FLAG])
			            )
			        )
			    )
			```
		lineageTag: f946eee6-c827-4a81-a3f6-818ce6a66e5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

