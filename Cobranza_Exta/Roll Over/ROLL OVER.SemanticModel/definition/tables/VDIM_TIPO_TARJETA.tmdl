/// Tipo de tarjeta
table VDIM_TIPO_TARJETA
	lineageTag: 81152100-be37-4cf7-a6fc-f6eb6362844d

	/// Organización
	column TIP_INF
		dataType: string
		lineageTag: 342e8b8a-e4a1-4884-83ec-017a7662ca8e
		summarizeBy: none
		sourceColumn: TIP_INF

		annotation SummarizationSetBy = Automatic

	/// Descripción de la organización
	column PRODUCTO
		dataType: string
		lineageTag: e7d753b4-37c3-4a25-923e-479991322e23
		summarizeBy: none
		sourceColumn: PRODUCTO

