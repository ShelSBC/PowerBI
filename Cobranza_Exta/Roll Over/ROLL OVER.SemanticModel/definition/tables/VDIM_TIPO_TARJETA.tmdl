	/// Color de acuerdo a la organización
	column COLOR
		dataType: string
		lineageTag: 5ab15c55-8d56-45ef-848c-8490a0f3bccf
		summarizeBy: none
		sourceColumn: COLOR

		annotation SummarizationSetBy = Automatic

	/// Agrupación de la organización
	column ORGANIZACION = ```
			IF(VDIM_TIPO_TARJETA[TIP_INF] IN {"100","110"},"LIVERPOOL", 
			        IF(VDIM_TIPO_TARJETA[TIP_INF] IN {"200","210","220","230"},"SUBURBIA"))
			```
		lineageTag: 1b892eab-7334-44cc-a058-26aee83aa765
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Descripción
	/// 
	column PRODUCTO_DESC = ```
			IF(VDIM_TIPO_TARJETA[TIP_INF] = "100" ,"LPC", 
			         IF(VDIM_TIPO_TARJETA[TIP_INF] = "110" ,"DILISA", 
			        IF(VDIM_TIPO_TARJETA[TIP_INF] = "200" ,"SUBURBIA VISA",
			        IF(VDIM_TIPO_TARJETA[TIP_INF] = "210","SUBURBIA DEPARTAMENTAL",
			         IF(VDIM_TIPO_TARJETA[TIP_INF] IN {"220","230"},"MINI PAGOS (CC)","")))))
			```
		lineageTag: 59183b3c-722f-44c9-bb3f-f3deefcacb86
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

