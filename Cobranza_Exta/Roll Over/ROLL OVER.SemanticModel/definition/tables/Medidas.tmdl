	measure 'Factor Castigo Final' = ```
			
			-- 1. Obtenemos los valores seleccionados y los tratamos como número
			VAR MesActualNum = VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[MES])) 
			VAR AnioActualNum = VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[ANIO_YYYY]))
			
			-- 2. Calculamos el mes y año anterior numéricamente
			VAR MesAnteriorNum = IF(MesActualNum = 1, 12, MesActualNum - 1)
			VAR AnioAnteriorNum = IF(MesActualNum = 1, AnioActualNum - 1, AnioActualNum)
			
			-- 3. Convertimos a texto con formato "00" para que coincida con tu dimensión (Ej: "01", "02")
			VAR MesAnteriorTexto = FORMAT(MesAnteriorNum, "00")
			VAR AnioAnteriorTexto = FORMAT(AnioAnteriorNum, "0")
			
			-- 4. Sumamos los Castigos del mes actual
			VAR CastigoActual = SUM('FAC_COB_ROLL_RATES'[SDO_CASTIGO]) 
			
			-- 5. Calculamos la base del mes anterior (Suma de los dos cubos de saldo)
			VAR SaldoMesAnteriorBase = 
			    CALCULATE(
			        SUM('FAC_COB_ROLL_RATES'[SDO_VIG_180_209]) + SUM('FAC_COB_ROLL_RATES'[SDO_VIG_210]),
			        ALL('VDIM_CALENDARIO'), 
			        'VDIM_CALENDARIO'[ANIO_YYYY] = AnioAnteriorTexto,
			        'VDIM_CALENDARIO'[MES] = MesAnteriorTexto
			    )
			
			-- 6. Resultado final
			RETURN
			DIVIDE(CastigoActual, SaldoMesAnteriorBase, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ROLL OVER
		lineageTag: b61cd7fa-fe14-47ef-b74f-6fe3f77c2017

	measure 'Factor Quitas' = ```
			
			VAR MesActualTexto = FORMAT(VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[MES])), "00")
			VAR AnioActualTexto = FORMAT(VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[ANIO_YYYY])), "0")
			VAR QuitasActuales = SUM('FAC_COB_ROLL_RATES'[SDO_QUITA])
			VAR SumaSaldosRango = 
			    CALCULATE(
			        SUM('FAC_COB_ROLL_RATES'[SDO_VIG_90_110]) + 
			        SUM('FAC_COB_ROLL_RATES'[SDO_VIG_120_149]) + 
			        SUM('FAC_COB_ROLL_RATES'[SDO_VIG_150_179]) + 
			        SUM('FAC_COB_ROLL_RATES'[SDO_VIG_180_209]) + 
			        SUM('FAC_COB_ROLL_RATES'[SDO_VIG_210]),
			        'VDIM_CALENDARIO'[MES] = MesActualTexto,
			        'VDIM_CALENDARIO'[ANIO_YYYY] = AnioActualTexto
			    )
			RETURN 
			DIVIDE(QuitasActuales,SumaSaldosRango,0)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ROLL OVER
		lineageTag: 01412847-9714-4a46-abae-29988f6001e3

	measure 'Factor Recuperacion' = ```
			
			VAR MesFijo = SELECTEDVALUE('VDIM_CALENDARIO'[MES])
			VAR AnioFijo = SELECTEDVALUE('VDIM_CALENDARIO'[ANIO_YYYY])
			VAR Numerador = SUM('FAC_COB_ROLL_RATES'[SUMA_PAGOS])
			VAR Denominador = 
			    CALCULATE(
			        SUM('FAC_COB_ROLL_RATES'[SDO_CASTIGO]),
			        ALL('VDIM_CALENDARIO'),
			        VAR MesN = VALUE(MesFijo)
			        VAR AnioN = VALUE(AnioFijo)
			        VAR F_Fin = EDATE(DATE(AnioN, MesN, 1), -1)
			        VAR F_Ini = EDATE(F_Fin, -11)
			        RETURN
			            FILTER(
			                ALL('VDIM_CALENDARIO'[MES], 'VDIM_CALENDARIO'[ANIO_YYYY]),
			                VAR FechaFila = DATE(VALUE('VDIM_CALENDARIO'[ANIO_YYYY]), VALUE('VDIM_CALENDARIO'[MES]), 1)
			                RETURN FechaFila >= F_Ini && FechaFila <= F_Fin
			            )
			    )
			RETURN 
			DIVIDE(Numerador, Denominador, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ROLL OVER
		lineageTag: 5aacf3ad-7044-4a2a-be74-53aa17b9a4ac

	measure Denominador_Castigos_12M =
			
			VAR MesSel = VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[MES]))
			VAR AnioSel = VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[ANIO_YYYY]))
			
			-- Rango: 12 meses atrás sin contar el actual
			VAR FechaFin = EDATE(DATE(AnioSel, MesSel, 1), -1)
			VAR FechaInicio = EDATE(FechaFin, -11)
			
			RETURN
			CALCULATE(
			    SUM('FAC_COB_ROLL_RATES'[SDO_CASTIGO]),
			    REMOVEFILTERS('VDIM_CALENDARIO'),
			    KEEPFILTERS(
			        VAR FilaFecha = DATE(VALUE('VDIM_CALENDARIO'[ANIO_YYYY]), VALUE('VDIM_CALENDARIO'[MES]), 1)
			        RETURN FilaFecha >= FechaInicio && FilaFecha <= FechaFin
			    )
			)
		displayFolder: ROLL OVER
		lineageTag: cc88baeb-d6ea-465f-95d6-0f7d76011844

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'D CV NETA' = ```
			
			-- 1. Identificar el Mes y Año seleccionado
			VAR MesSeleccionado = VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[MES]))
			VAR AnioSeleccionado = VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[ANIO_YYYY]))
			
			-- 2. Calcular la Cartera Vencida del MES ACTUAL
			VAR CV_Actual = SUM('FAC_COB_ROLL_RATES'[SDO_CARTERA_VENCIDA])
			
			-- 3. Calcular la Cartera Vencida del MES ANTERIOR
			VAR FechaMesAnterior = EDATE(DATE(AnioSeleccionado, MesSeleccionado, 1), -1)
			VAR MesAnteriorTexto = FORMAT(MONTH(FechaMesAnterior), "00")
			VAR AnioAnteriorTexto = FORMAT(YEAR(FechaMesAnterior), "0")
			
			VAR CV_Anterior = 
			    CALCULATE(
			        SUM('FAC_COB_ROLL_RATES'[SDO_CARTERA_VENCIDA]),
			        ALL('VDIM_CALENDARIO'),
			        'VDIM_CALENDARIO'[MES] = MesAnteriorTexto,
			        'VDIM_CALENDARIO'[ANIO_YYYY] = AnioAnteriorTexto
			    )
			
			-- 4. Resultado: Resta de Actual - Anterior
			RETURN
			IF(
			    ISBLANK(CV_Actual), 
			    BLANK(), 
			    CV_Actual - CV_Anterior
			)
			```
		displayFolder: ROLL OVER
		lineageTag: 2e5e27b5-04d6-4213-b496-33c1ac50bafc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cartera Promedio 12M' = ```
			
			-- 1. Identificar el mes "ancla" desde el filtro
			VAR MesSeleccionado = VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[MES]))
			VAR AnioSeleccionado = VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[ANIO_YYYY]))
			
			-- 2. Definir el rango: desde hace 12 meses hasta el mes anterior al seleccionado
			-- Ejemplo: Si seleccionas Abril 2025, el rango es Mayo 2024 - Marzo 2025
			VAR FechaFinRango = EDATE(DATE(AnioSeleccionado, MesSeleccionado, 1), -1)
			VAR FechaInicioRango = EDATE(FechaFinRango, -11)
			
			-- 3. Calcular la suma de la cartera en ese periodo de 12 meses
			VAR SumaCartera12M = 
			    CALCULATE(
			        SUM('FAC_COB_ROLL_RATES'[SDO_CARTERA_TOT]), -- Cambia por el nombre exacto de tu columna
			        ALL('VDIM_CALENDARIO'),
			        KEEPFILTERS(
			            VAR FilaFecha = DATE(VALUE('VDIM_CALENDARIO'[ANIO_YYYY]), VALUE('VDIM_CALENDARIO'[MES]), 1)
			            RETURN FilaFecha >= FechaInicioRango && FilaFecha <= FechaFinRango
			        )
			    )
			
			-- 4. Dividir entre 12 para obtener el promedio mensual
			RETURN
			DIVIDE(SumaCartera12M, 12, 0)
			```
		displayFolder: ROLL OVER
		lineageTag: 8cba32bd-9eda-4daf-bd31-ec8d492a1940

