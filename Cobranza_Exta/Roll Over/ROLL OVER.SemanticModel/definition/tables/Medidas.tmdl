	measure CRECIMIENTO_CARTERA_TOT = ```
			
			VAR SaldoActual = SUM('FAC_COB_ROLL_RATES'[sdo_cartera_tot])
			VAR MesActualNum = VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[MES]))
			VAR AnioActualNum = VALUE(SELECTEDVALUE('VDIM_CALENDARIO'[ANIO_YYYY]))
			VAR MesAnteriorNum = IF(MesActualNum = 1, 12, MesActualNum - 1)
			VAR AnioAnteriorNum = IF(MesActualNum = 1, AnioActualNum - 1, AnioActualNum)
			
			VAR MesAnteriorTexto = FORMAT(MesAnteriorNum, "00")
			VAR AnioAnteriorTexto = FORMAT(AnioAnteriorNum, "0")
			VAR SaldoMesAnterior = 
			    CALCULATE(
			        SUM('FAC_COB_ROLL_RATES'[SDO_CARTERA_TOT]),
			        ALL('VDIM_CALENDARIO'),
			        'VDIM_CALENDARIO'[MES] = MesAnteriorTexto, 
			        'VDIM_CALENDARIO'[ANIO_YYYY] = AnioAnteriorTexto
			    )
			
			RETURN
			IF(
			    SaldoMesAnterior = 0, 
			    0, 
			    DIVIDE(SaldoActual, SaldoMesAnterior) - 1
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ROLL OVER
		lineageTag: 7df0953e-5692-4794-9ed4-55799e50c60e

