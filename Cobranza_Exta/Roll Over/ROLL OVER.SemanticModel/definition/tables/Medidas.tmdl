	measure Variacion_Vig_0_1 = ```
			
			-- 1. Capturamos el Mes y Año de la gráfica
			VAR MesActual = MAX('FAC_COB_ROLL_RATES'[MES])
			VAR AnioActual = MAX('FAC_COB_ROLL_RATES'[ANIO])
			
			-- 2. Calculamos el valor del mes actual
			VAR ValorActual = SUM('FAC_COB_ROLL_RATES'[SDO_VIG_0_1])
			
			-- 3. Buscamos el valor del mes anterior usando una tabla filtrada
			VAR ValorAnterior = 
			    CALCULATE(
			        SUM('FAC_COB_ROLL_RATES'[SDO_VIG_0_1]),
			        FILTER(
			            ALLSELECTED('FAC_COB_ROLL_RATES'),
			            'FAC_COB_ROLL_RATES'[MES] = IF(MesActual = 1, 12, MesActual - 1) &&
			            'FAC_COB_ROLL_RATES'[ANIO] = IF(MesActual = 1, AnioActual - 1, AnioActual)
			        )
			    )
			
			-- 4. Cálculo final
			RETURN 
			    IF(
			        ISBLANK(ValorActual) || ISBLANK(ValorAnterior) || ValorAnterior = 0, 
			        0, 
			        DIVIDE(ValorActual - ValorAnterior, ValorAnterior)
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ROLL OVER
		lineageTag: cb84f87c-5d9a-4818-8fe5-678d5351e844

